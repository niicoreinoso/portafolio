# Copiá este archivo como .env.local y completá los valores.

# Contraseña para entrar al panel en /admin
ADMIN_PASSWORD=cambiame

# Cadena aleatoria larga para firmar la sesión del admin
# (podés generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=

# API key de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo a usar. "gemini-flash-latest" apunta siempre al Flash más reciente.
GEMINI_MODEL=gemini-flash-latest

# Opcional: token de GitHub (sin permisos) para evitar el límite de 60 req/hora
GITHUB_TOKEN=

# Mostrar el chatbot público en la web (true/false). Requiere GEMINI_API_KEY.
PUBLIC_CHAT_ENABLED=true
